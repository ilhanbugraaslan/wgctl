# WireGuard settings — copy to wg.env and edit.
#   cp wg.env.example wg.env
# wg.env is gitignored because it holds your real endpoint and host details.

WG_SSH_HOST=myserver                # alias in ~/.ssh/config
WG_IFACE=wg0
WG_PORT=51825                       # the router must forward UDP to this port
WG_SUBNET=10.10.0.0/24
WG_SERVER_IP=10.10.0.1

# Where clients connect. Use a DDNS name here if the public IP is dynamic.
WG_ENDPOINT=vpn.example.com
WG_SERVER_LAN_IP=192.168.1.10       # server LAN address, used by home-profile

WG_LAN=192.168.1.0/24               # the server's local network
WG_EGRESS=eth0                      # NAT egress interface (eth0, ens18, vmbr0, ...)

# Host TCP ports reachable from the LAN and the VPN (multiport, max 15)
WG_HOST_PORTS=22,8006,80,443,8080

WG_CLIENT_DNS="1.1.1.1, 1.0.0.1"
# Split tunnel: only these networks go through the tunnel.
# For a full tunnel use: "0.0.0.0/0, ::/0"
WG_ALLOWED_IPS="10.10.0.0/24, 192.168.1.0/24"

# Raw URL of install.sh, used by `wgctl.sh bootstrap`.
WG_INSTALL_URL=https://raw.githubusercontent.com/<user>/<repo>/main/install.sh
